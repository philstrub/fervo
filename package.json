{
  "name": "fervo",
  "version": "0.2.0",
  "description": "Repo management for agent contributors",
  "keywords": [
    "agents",
    "git",
    "code-review",
    "evaluation",
    "coding-agents"
  ],
  "license": "MIT",
  "homepage": "https://github.com/PhilStrub/fervo#readme",
  "bugs": "https://github.com/PhilStrub/fervo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhilStrub/fervo.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./extension": {
      "types": "./dist/src/extension.d.ts",
      "default": "./dist/src/extension.js"
    }
  },
  "bin": {
    "fervo": "dist/src/cli/main.js"
  },
  "files": [
    "dist/src",
    "settings.default.json",
    "skill"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/src/cli/main.js', 0o755)\"",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "schemas": "npm run build && FERVO_WRITE_SCHEMAS=1 node --test dist/tests/schemas.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^14.0.0",
    "minimatch": "^11.0.2",
    "openai": "^7.45.1",
    "smol-toml": "^1.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
