{
  "name": "fervo",
  "version": "0.1.0",
  "description": "Repo management for agent contributors",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "fervo": "dist/src/cli/main.js"
  },
  "files": [
    "dist/src",
    "skill"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/src/cli/main.js', 0o755)\"",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^14.0.0",
    "minimatch": "^11.0.2",
    "openai": "^7.45.1",
    "smol-toml": "^1.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
