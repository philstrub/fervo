{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Overlap",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "claim",
        "node"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "by": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "intent": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "kind",
    "id",
    "by",
    "scope",
    "intent"
  ]
}
