{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActorCreated",
  "type": "object",
  "properties": {
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "runner",
            "enroller",
            "system"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        },
        "disabled": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "provider",
        "model",
        "harness",
        "owner",
        "session",
        "disabled"
      ]
    },
    "token": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "actor",
    "token"
  ]
}
