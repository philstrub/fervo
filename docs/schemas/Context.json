{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context",
  "type": "object",
  "properties": {
    "goal": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "enum": [
              "max",
              "min"
            ]
          },
          "weight": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "direction",
          "weight"
        ]
      }
    },
    "main": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number"
        }
      },
      "required": [
        "commit",
        "node"
      ]
    },
    "frontier": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "score": {
            "type": "number"
          },
          "delta": {
            "type": "number"
          },
          "interval": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "node",
          "interval",
          "intent",
          "author",
          "ref"
        ]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lease": {
            "type": "string",
            "minLength": 1
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "since": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "lease",
          "by",
          "scope",
          "intent",
          "since"
        ]
      }
    },
    "tried": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "state": {
            "type": "string",
            "enum": [
              "submitted",
              "evaluating",
              "verified",
              "merged",
              "reverted",
              "rejected",
              "failed",
              "abandoned"
            ]
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "improved",
                  "within_noise",
                  "worse"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "node",
          "intent",
          "outcome"
        ]
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "pinned": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requirements_by_path": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "pinned",
        "requirements_by_path"
      ]
    },
    "mine": {
      "type": "object",
      "properties": {
        "leases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lease": {
                "type": "string",
                "minLength": 1
              },
              "by": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "intent": {
                "type": "string",
                "minLength": 1
              },
              "since": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "lease",
              "by",
              "scope",
              "intent",
              "since"
            ]
          }
        },
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "event": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "subject",
              "event",
              "at"
            ]
          }
        }
      },
      "required": [
        "leases",
        "updates"
      ]
    },
    "frontier_version": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "summary": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "ready"
              ]
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "job": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "text",
            "job"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "goal",
    "metrics",
    "main",
    "frontier",
    "claims",
    "tried",
    "rules",
    "mine",
    "frontier_version"
  ]
}
