{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grant",
  "type": "object",
  "properties": {
    "grant": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "grant",
    "expires_at"
  ]
}
