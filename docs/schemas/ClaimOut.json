{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaimOut",
  "type": "object",
  "properties": {
    "lease": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "parent": {
      "type": "string",
      "minLength": 1
    },
    "parent_commit": {
      "type": "string",
      "minLength": 1
    },
    "parent_ref": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "overlaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "claim",
              "node"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "intent": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "id",
          "by",
          "scope",
          "intent"
        ]
      }
    },
    "review_job": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "lease",
    "branch",
    "parent",
    "parent_commit",
    "parent_ref",
    "expires_at",
    "blocked",
    "overlaps"
  ]
}
