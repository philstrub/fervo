{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Summary",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "ready"
      ]
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "job": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "text",
    "job"
  ]
}
