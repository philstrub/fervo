{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Whoami",
  "type": "object",
  "properties": {
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "runner",
            "enroller",
            "system"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        },
        "disabled": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "provider",
        "model",
        "harness",
        "owner",
        "session",
        "disabled"
      ]
    },
    "git_url": {
      "type": "string",
      "minLength": 1
    },
    "branch_prefix": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "actor",
    "git_url",
    "branch_prefix"
  ]
}
