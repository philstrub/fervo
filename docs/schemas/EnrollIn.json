{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnrollIn",
  "type": "object",
  "properties": {
    "session": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{8,}$"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "grant": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "session",
    "model"
  ]
}
