{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LeaseJob",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "claim_review",
        "eval",
        "review",
        "summary",
        "postmerge",
        "baseline"
      ]
    },
    "node": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "claim": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "done",
        "failed"
      ]
    },
    "commit": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_commit": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "intent": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "author": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "author_provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "baselines": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "mean": {
            "type": "number"
          },
          "sd": {
            "type": "number"
          }
        },
        "required": [
          "mean",
          "sd"
        ]
      }
    }
  },
  "required": [
    "id",
    "kind",
    "node",
    "state",
    "commit",
    "parent_commit",
    "intent",
    "scope",
    "author",
    "author_provider",
    "baselines"
  ]
}
